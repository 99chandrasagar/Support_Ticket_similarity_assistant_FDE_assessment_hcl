# Publish only the submission and portable presentation helpers.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/PRESENT_NOW.md
!/START_PANEL_DEMO.cmd
!/present_to_panel.py
!/support-ticket-assistant/

# Local runtime files and credentials must never enter the repository.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.log
.env
.env.*
*.pem
*.key
*credentials*.json
.DS_Store
